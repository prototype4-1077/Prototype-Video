PALETTES = {
    "cyan": ((4, 12, 22), (11, 44, 61), (70, 226, 238), (232, 252, 255)),
    "amber": ((20, 9, 4), (80, 36, 12), (255, 176, 61), (255, 244, 212)),
    "violet": ((13, 6, 27), (54, 22, 87), (193, 124, 255), (248, 236, 255)),
