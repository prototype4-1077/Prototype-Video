      "scenes": [
        {
          "effective_query": "a glowing wavelength of a spoken name",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 0,
          "original_query": null,
          "primary_symbol": "spoken name as a wavelength",
          "query_family": "nature",
          "selected_family": "light_atmosphere",
          "semantic_anchor": "hook — issue the dare",
          "symbol_family": "geometry",
          "text": "Say your own name. Out loud. Now say it again — and again — thirty times, until your tongue starts tripping over it.",
          "visual_function": "hook — issue the dare"
        },
        {
          "effective_query": "a sound dissolving into slow ripples",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 1,
          "original_query": null,
          "primary_symbol": "a sound dissolving",
          "query_family": "nature",
          "selected_family": "nature",
          "semantic_anchor": "the effect lands",
          "symbol_family": "transformation",
          "text": "Somewhere around the twentieth, something goes sideways. The name stops being yours. It's just a sound. A little noise your mouth makes.",
          "visual_function": "the effect lands"
        },
        {
          "effective_query": "a looking glass reflection quietly reversing",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 2,
          "original_query": null,
          "primary_symbol": "a mirror reversing its reflection",
          "query_family": "perception",
          "selected_family": "pathway",
          "semantic_anchor": "name the mechanism",
          "symbol_family": "perception",
          "text": "That's not you losing it. That's a glitch with a name. Jamais vu — the opposite of deja vu. Instead of the strange feeling familiar, the familiar goes strange.",
          "visual_function": "name the mechanism"
        },
        {
          "effective_query": "an ink stamp tool pressing a blank sheet",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 3,
          "original_query": null,
          "primary_symbol": "a stamp pressing a blank sheet",
          "query_family": "object_tool",
          "selected_family": null,
          "semantic_anchor": "the ruling metaphor",
          "symbol_family": "object_tool",
          "text": "Your brain runs on a stamp. A little rubber stamp that hits every face, every word, every object, and goes: known, known, known. You never see the stamp. You only see the world it already approved.",
          "visual_function": "the ruling metaphor"
        },
        {
          "effective_query": "a paper label unfolding and lifting off a glass jar",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 4,
          "original_query": null,
          "primary_symbol": "a label lifting off a jar",
          "query_family": "language",
          "selected_family": null,
          "semantic_anchor": "deepen the metaphor",
          "symbol_family": "transformation",
          "text": "Semantic satiation is what happens when you wear that stamp out. Say a word enough times and the ink runs dry. The meaning peels off the sound like a label off a bottle.",
          "visual_function": "deepen the metaphor"
        },
        {
          "effective_query": "raw soil and root texture seen in macro",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 5,
          "original_query": null,
          "primary_symbol": "raw material in macro",
          "query_family": "nature",
          "selected_family": null,
          "semantic_anchor": "reveal what's under",
          "symbol_family": "nature",
          "text": "And underneath the label? The raw thing. The actual noise. The strangeness that was sitting there the whole time — just covered.",
          "visual_function": "reveal what's under"
        },
        {
          "effective_query": "an open human hand turning into an unfamiliar object",
          "generic_human": false,
          "human_present": true,
          "human_role": "observer",
          "index": 6,
          "original_query": null,
          "primary_symbol": "own hand as an object",
          "query_family": "nature",
          "selected_family": null,
          "semantic_anchor": "hand the test to the body",
          "symbol_family": "human",
          "text": "You can do it with your own hand. Look at it. Really look. Past 'my hand' into the thing itself — five soft hooks, wet joints, a fold that opens and closes.",
          "visual_function": "hand the test to the body"
        },
        {
          "effective_query": "a mannequin hand resting on a plain surface",
          "generic_human": false,
          "human_present": true,
          "human_role": "unspecified",
          "index": 7,
          "original_query": null,
          "primary_symbol": "a hand seen as a worn object",
          "query_family": "identity",
          "selected_family": "human",
          "semantic_anchor": "the hand becomes a thing",
          "symbol_family": "identity",
          "text": "Stare long enough and it becomes an object you happen to be wearing.",
          "visual_function": "the hand becomes a thing"
        },
        {
          "effective_query": "an ordinary kitchen room with a window, uncanny",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 8,
          "original_query": null,
          "primary_symbol": "an ordinary kitchen made strange",
          "query_family": "architecture",
          "selected_family": null,
          "semantic_anchor": "the felt sense",
          "symbol_family": "architecture",
          "text": "It's a small vertigo, isn't it? The floor of the ordinary drops out. And for one second you're a stranger in your own kitchen, holding a fork you've never seen before.",
          "visual_function": "the felt sense"
        },
        {
          "effective_query": "an airport gate signpost and corridor at night",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 9,
          "original_query": null,
          "primary_symbol": "an airport gate at night",
          "query_family": "architecture",
          "selected_family": null,
          "semantic_anchor": "the reframe",
          "symbol_family": "pathway",
          "text": "Here's the part I love. People spend real money chasing this feeling. The world made new, the veil lifted. And it was free the whole time — built right into the hardware.",
          "visual_function": "the reframe"
        },
        {
          "effective_query": "a translucent veil and haze over an ordinary street",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 10,
          "original_query": null,
          "primary_symbol": "a veil over the ordinary",
          "query_family": "nature",
          "selected_family": null,
          "semantic_anchor": "locate it in the viewer",
          "symbol_family": "light_atmosphere",
          "text": "Because the familiarity was never in the thing. It was in you — a habit of prediction laid over the top so smoothly you mistook it for the world.",
          "visual_function": "locate it in the viewer"
        },
        {
          "effective_query": "an ordinary street dissolving into a vast galaxy",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 11,
          "original_query": null,
          "primary_symbol": "the ordinary opening into a galaxy",
          "query_family": "nature",
          "selected_family": null,
          "semantic_anchor": "the turn",
          "symbol_family": "world_scale",
          "text": "The word didn't change. Your hand didn't change. The stamp just skipped — and for a moment you saw what's always underneath: a universe that never actually agreed to be ordinary.",
          "visual_function": "the turn"
        },
        {
          "effective_query": "an empty chair by a bright window in a quiet room",
          "generic_human": false,
          "human_present": false,
          "human_role": null,
          "index": 12,
          "original_query": null,
          "primary_symbol": "empty chair by a window",
          "query_family": "architecture",
          "selected_family": "architecture",
          "semantic_anchor": "the thesis, plainly",
          "symbol_family": "architecture",
          "text": "Wonder isn't a place you have to travel to. It's a glitch. And you can trigger it on purpose — in a chair, with a single word.",
          "visual_function": "the thesis, plainly"
        },
        {
          "effective_query": "an afternoon sun ray moving across an open hand",
          "generic_human": false,
          "human_present": true,
          "human_role": "observer",
          "index": 13,
          "original_query": null,
          "primary_symbol": "light moving across a hand",
          "query_family": "nature",
          "selected_family": "human",
          "semantic_anchor": "the invitation",
          "symbol_family": "light_atmosphere",
          "text": "So here's the test. Look at your own hand until it turns back into an object. That astonishment — it was always available. You just never stared long enough to be surprised.",
          "visual_function": "the invitation"
        }
      ],
