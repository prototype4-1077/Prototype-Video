  "dialogue_cues": [
    {"id": "DX_001", "shot_id": "GS010", "start_frame": 4, "end_frame": 55, "gain_db": -1.0, "text": "The fellow from the feed store"},
    {"id": "DX_002", "shot_id": "GS010", "start_frame": 59, "end_frame": 105, "gain_db": -0.5, "text": "borrowed twelve dollars—"},
    {"id": "DX_003", "shot_id": "GS020", "start_frame": 131, "end_frame": 171, "gain_db": -1.5, "text": "and this enamel mug—"},
    {"id": "DX_004", "shot_id": "GS020", "start_frame": 175, "end_frame": 225, "gain_db": -1.0, "text": "the same Tuesday. Returned neither."},
    {"id": "DX_005", "shot_id": "GS030", "start_frame": 230, "end_frame": 258, "gain_db": -1.5, "text": "Three years later,"},
    {"id": "DX_006", "shot_id": "GS030", "start_frame": 262, "end_frame": 311, "gain_db": -1.0, "text": "he brought the mug back,"},
    {"id": "DX_007", "shot_id": "GS030", "start_frame": 315, "end_frame": 374, "gain_db": -1.0, "text": "plus a pie his wife made,"},
    {"id": "DX_008", "shot_id": "GS040", "start_frame": 400, "end_frame": 480, "gain_db": 0.5, "text": "apologizing like he'd misplaced the courthouse."},
    {"id": "DX_009", "shot_id": "GS040", "start_frame": 484, "end_frame": 536, "gain_db": -2.0, "text": "I reached for my little ledger..."},
    {"id": "DX_010", "shot_id": "GS050", "start_frame": 570, "end_frame": 642, "gain_db": -4.0, "text": "then watched his hand shake."},
    {"id": "DX_011", "shot_id": "GS060", "start_frame": 682, "end_frame": 742, "gain_db": 0.5, "text": "Keeping score tells you what you're owed."},
    {"id": "DX_012", "shot_id": "GS060", "start_frame": 746, "end_frame": 814, "gain_db": 0.5, "text": "It can't tell you what a man is carrying."},
    {"id": "DX_013", "shot_id": "GS060", "start_frame": 818, "end_frame": 867, "gain_db": -1.0, "text": "So I set the pencil down"},
    {"id": "DX_014", "shot_id": "GS060", "start_frame": 871, "end_frame": 910, "gain_db": -1.0, "text": "and poured him coffee."},
    {"id": "DX_015", "shot_id": "GS070", "start_frame": 937, "end_frame": 956, "gain_db": -2.5, "text": "Funny thing:"},
    {"id": "DX_016", "shot_id": "GS070", "start_frame": 958, "end_frame": 1006, "gain_db": -0.5, "text": "the account got lighter before the debt did."},
    {"id": "DX_017", "shot_id": "GS070", "start_frame": 1009, "end_frame": 1038, "gain_db": -2.0, "text": "What are you carrying"},
    {"id": "DX_018", "shot_id": "GS070", "start_frame": 1041, "end_frame": 1078, "gain_db": -1.0, "text": "just because the ledger says so?"}
  ],
